{
  "name": "monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf apps/*/dist packages/*/dist && find . -name *.tsbuildinfo -type f -delete",
    "start:server": "pnpm --filter @monorepo/server start",
    "build:server": "pnpm --filter @monorepo/server build",
    "build:web": "pnpm --filter @monorepo/web build",
    "dev:server": "pnpm --filter @monorepo/server dev",
    "dev:web": "pnpm --filter @monorepo/web dev"
  },
  "packageManager": "pnpm@10.33.0"
}
